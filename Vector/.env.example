# --- LLM Provider API Keys ---
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# --- Default Models ---
CLAUDE_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-2.5-pro

# --- LLM selection: "claude" or "gemini" ---
DEFAULT_LLM_PROVIDER=claude

# --- Google Programmable Search (for GoogleSearchTool / lead enrichment) ---
# Create a key: https://developers.google.com/custom-search/v1/overview
# Create an engine (cx): https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=your-google-custom-search-api-key
GOOGLE_CSE_CX=your-search-engine-id

# --- Email-finding providers (Detective) ---
# Configure which provider Detective uses in modules/scout/detective/config.py
# (EMAIL_PROVIDER = "apollo" | "pdl"). A keyless pattern+SMTP generator is the
# automatic fallback when the provider returns nothing.
APOLLO_API_KEY=your-apollo-api-key
PDL_API_KEY=your-people-data-labs-api-key

# --- PULSE / Inbox: sending mailbox(es) ---
# Outreach sends over plain SMTP and reads replies over IMAP — no paid API.
# Use an APP PASSWORD (not your login password). For Gmail/Workspace, enable
# 2FA then create one at https://myaccount.google.com/apppasswords.
#
# Option A — a single mailbox (host/port auto-detected for common providers):
PULSE_EMAIL=you@yourdomain.com
PULSE_EMAIL_PASSWORD=your-app-password
PULSE_FROM_NAME=Your Name
# Override host/port only if auto-detection doesn't cover your provider:
# PULSE_SMTP_HOST=smtp.gmail.com
# PULSE_SMTP_PORT=465
# PULSE_IMAP_HOST=imap.gmail.com
# PULSE_IMAP_PORT=993
#
# Option B — a POOL of mailboxes (rotation + warmup across all of them). JSON
# array; if set, this WINS over the single-mailbox vars above:
# PULSE_MAILBOXES=[{"email":"a@dom.com","password":"pw","from_name":"A","daily_cap":40},{"email":"b@dom.com","password":"pw2","from_name":"B","daily_cap":40}]
#
# Timezone for the business-hours send window (IANA name):
PULSE_TIMEZONE=UTC

# --- PULSE autonomous mode ---
# Let the ConversationAgent auto-reply to prospects unattended (book calls,
# answer questions, close politely). OFF by default — it emails real people.
# When off, replies are still classified + drafted, but held for human review.
PULSE_AUTO_REPLY=false
# Optional booking link the agent shares when a prospect wants to talk. If empty,
# the agent asks for their availability instead.
PULSE_MEETING_LINK=

# --- PULSE / Connect: LinkedIn transport ---
# Which backend sends LinkedIn actions: mock | phantombuster | unipile
#   mock          — simulated, zero cost / zero ban risk (default; for dev+tests)
#   phantombuster — free tier has API + ~30 min/mo execution (good for demos)
#   unipile       — 7-day free trial, cleanest native LinkedIn API
PULSE_CONNECT_PROVIDER=mock

# PhantomBuster: create the phantoms once in their UI (each wired to your
# LinkedIn session cookie), then put their agent ids here.
PHANTOMBUSTER_API_KEY=
PB_CONNECT_AGENT_ID=          # LinkedIn Auto Connect phantom
PB_MESSAGE_AGENT_ID=          # LinkedIn Message Sender phantom
PB_PROFILE_AGENT_ID=          # Profile Scraper (for acceptance detection)
PB_INBOX_AGENT_ID=            # Inbox/Message extractor (for replies)
# Optional: pass the session cookie via API instead of the UI
PHANTOMBUSTER_LI_AT=
PHANTOMBUSTER_USER_AGENT=

# Unipile: connect your LinkedIn account once via the Hosted Auth wizard, then
# copy the DSN (host:port), API key, and account id from the dashboard.
UNIPILE_DSN=                  # e.g. api8.unipile.com:13443
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# --- PULSE / Scheduling: calendar for autonomous meeting booking ---
# Backend the reply agent books into: mock | google
#   mock   — in-memory calendar (default; tests + dry demos, zero setup)
#   google — real Google Calendar (free): free/busy + event + Meet link
PULSE_CALENDAR_PROVIDER=mock
# Meeting shape + host availability window (host timezone):
PULSE_MEETING_DURATION_MIN=30
PULSE_MEETING_TIMEZONE=Asia/Kolkata
PULSE_MEETING_START_HOUR=9
PULSE_MEETING_END_HOUR=17
PULSE_MEETING_LOOKAHEAD_DAYS=10
PULSE_SLOTS_TO_OFFER=3
# Google Calendar (only when PULSE_CALENDAR_PROVIDER=google). One-time OAuth:
# download an OAuth client (Desktop) JSON from Google Cloud → set the client file;
# first run opens a consent window and saves the token file for reuse.
#   pip install google-api-python-client google-auth-httplib2 google-auth-oauthlib
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=data/pulse/google_token.json

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
